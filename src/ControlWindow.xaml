<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F4F6" TextElement.FontFamily="Segoe UI" TextElement.FontSize="13" TextElement.Foreground="#1F2937"
      UseLayoutRounding="True">
  <Grid.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12,14,12"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Val" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.65"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Border x:Name="track" Grid.Column="1" Width="38" Height="20" CornerRadius="10" Background="#C7CCD4" VerticalAlignment="Center">
                <Ellipse x:Name="knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#2563EB"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="track" Property="BorderBrush" Value="#93C5FD"/>
                <Setter TargetName="track" Property="BorderThickness" Value="2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,6,0">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#DBEAFE"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#2563EB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SliderFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="#2563EB"/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderRest" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Ellipse x:Name="e" Width="16" Height="16" Fill="White" Stroke="#2563EB" StrokeThickness="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="e" Property="Fill" Value="#DBEAFE"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Margin" Value="0,2,0,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="20" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#E5E7EB" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderRest}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Kbd" TargetType="Border">
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>
  </Grid.Resources>

  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="340"/>
  </Grid.ColumnDefinitions>

  <!-- Script editor -->
  <Grid Grid.Column="0" Margin="16,16,12,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="Your script" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#111827"/>
      <Button x:Name="ClearBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Clear" Margin="8,0,0,0"/>
      <Button x:Name="OpenBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Open file…" Margin="8,0,0,0"/>
      <Button x:Name="PasteBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Paste" Margin="8,0,0,0" ToolTip="Replace the script with the text on your clipboard (Ctrl+Z undoes it)"/>
    </DockPanel>
    <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="4">
      <TextBox x:Name="ScriptBox" BorderThickness="0" Padding="10,8" FontSize="15" AcceptsReturn="True" AcceptsTab="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#111827"
               SelectionBrush="#2563EB" AutomationProperties.Name="Script"/>
    </Border>
    <DockPanel Grid.Row="2" Margin="2,8,2,0">
      <TextBlock x:Name="WordInfo" DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="12,0,0,0"/>
      <TextBlock Style="{StaticResource Hint}" Text="Tip: text in [square brackets] shows dimmed, for cues like [pause] or [smile]."/>
    </DockPanel>
  </Grid>

  <!-- Settings -->
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,16,16,4" Focusable="False">
    <StackPanel>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayBtn" Style="{StaticResource Primary}" AutomationProperties.Name="Start"/>
            <Button x:Name="RestartBtn" Grid.Column="2" Style="{StaticResource Btn}" Padding="12,10" ToolTip="Back to the start (Ctrl+Alt+R)" AutomationProperties.Name="Restart">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Restart" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,8,0,10" Text="Paused" AutomationProperties.AutomationId="StatusText"/>
          <DockPanel><TextBlock x:Name="SpeedVal" DockPanel.Dock="Right" Style="{StaticResource Val}"/><TextBlock Text="Scroll speed"/></DockPanel>
          <Slider x:Name="SpeedSlider" Minimum="1" Maximum="20" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Scroll speed"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Text"/>
          <DockPanel><TextBlock x:Name="SizeVal" DockPanel.Dock="Right" Style="{StaticResource Val}"/><TextBlock Text="Text size"/></DockPanel>
          <Slider x:Name="SizeSlider" Minimum="14" Maximum="96" SmallChange="1" LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Text size"/>
          <TextBlock Text="Font" Margin="0,0,0,4"/>
          <ComboBox x:Name="FontBox" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center" AutomationProperties.Name="Font"
                    VirtualizingStackPanel.IsVirtualizing="True">
            <ComboBox.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="14"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Align" Margin="0,0,0,4"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AlignCenter" GroupName="align" Style="{StaticResource Seg}" Content="Center"/>
                <RadioButton x:Name="AlignLeft" GroupName="align" Style="{StaticResource Seg}" Content="Left"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Look" Margin="0,0,0,4"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{StaticResource Seg}" Content="Dark"/>
                <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{StaticResource Seg}" Content="Light"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Voice activation"/>
          <CheckBox x:Name="VoiceSwitch" Style="{StaticResource Switch}" AutomationProperties.Name="Voice activation">
            <TextBlock Text="Scroll only while I'm talking" TextWrapping="Wrap"/>
          </CheckBox>
          <StackPanel x:Name="VoicePanel" Margin="0,8,0,0">
            <Grid Height="10" Margin="0,0,0,4">
              <Border x:Name="MeterTrack" CornerRadius="5" Background="#E5E7EB"/>
              <Border x:Name="MeterFill" CornerRadius="5" Background="#22C55E" HorizontalAlignment="Left" Width="0"/>
              <Rectangle x:Name="MeterMark" Width="2" Fill="#111827" HorizontalAlignment="Left"/>
            </Grid>
            <TextBlock x:Name="VoiceStatus" Style="{StaticResource Hint}" Margin="0,0,0,8" AutomationProperties.AutomationId="VoiceStatus"/>
            <DockPanel><TextBlock x:Name="SensVal" DockPanel.Dock="Right" Style="{StaticResource Val}"/><TextBlock Text="Mic sensitivity"/></DockPanel>
            <Slider x:Name="SensSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Mic sensitivity"/>
            <TextBlock Style="{StaticResource Hint}" Text="Talk normally: the bar should pass the black line. Raise sensitivity if it doesn't, lower it if background noise scrolls the text."/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Prompter window"/>
          <CheckBox x:Name="ShowSwitch" Style="{StaticResource Switch}" Content="Show prompter" AutomationProperties.Name="Show prompter"/>
          <CheckBox x:Name="HideSwitch" Style="{StaticResource Switch}" AutomationProperties.Name="Hide from screen sharing">
            <TextBlock Text="Hide from screen sharing and recording" TextWrapping="Wrap"/>
          </CheckBox>
          <CheckBox x:Name="HoverSwitch" Style="{StaticResource Switch}" AutomationProperties.Name="Pause on hover">
            <TextBlock Text="Pause while the mouse is over it" TextWrapping="Wrap"/>
          </CheckBox>
          <TextBlock Text="Display" Margin="0,8,0,4"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="DisplayBox" Height="30" VerticalContentAlignment="Center" AutomationProperties.Name="Display"/>
            <Button x:Name="CenterBtn" Grid.Column="2" Style="{StaticResource Btn}" Content="Snap to top" ToolTip="Put the prompter back at the top-center of the display"/>
          </Grid>
          <DockPanel><TextBlock x:Name="WidthVal" DockPanel.Dock="Right" Style="{StaticResource Val}"/><TextBlock Text="Width"/></DockPanel>
          <Slider x:Name="WidthSlider" Minimum="220" Maximum="1600" SmallChange="10" LargeChange="40" TickFrequency="10" IsSnapToTickEnabled="True" AutomationProperties.Name="Width"/>
          <DockPanel><TextBlock x:Name="HeightVal" DockPanel.Dock="Right" Style="{StaticResource Val}"/><TextBlock Text="Height"/></DockPanel>
          <Slider x:Name="HeightSlider" Minimum="80" Maximum="800" SmallChange="10" LargeChange="40" TickFrequency="10" IsSnapToTickEnabled="True" AutomationProperties.Name="Height"/>
          <DockPanel><TextBlock x:Name="OpacityVal" DockPanel.Dock="Right" Style="{StaticResource Val}"/><TextBlock Text="Background opacity"/></DockPanel>
          <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Background opacity"/>
          <TextBlock Style="{StaticResource Hint}" Text="You can also drag the prompter to move it, drag its edges to resize it, and double-click it to snap it back to the top."/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource CardTitle}" Text="Hotkeys (work in any app)"/>
          <Grid x:Name="HotkeyGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          </Grid>
          <TextBlock x:Name="HotkeyWarn" Style="{StaticResource Hint}" Foreground="#B91C1C" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Grid>
